# Pooled connection for application queries
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/database?sslmode=require&channel_binding=require

# Direct connection for Drizzle Kit schema pushes
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/database?sslmode=require&channel_binding=require

# Same private values on the local Next server and its Trigger worker.
# Generate an installation ID with crypto.randomUUID() and a 32-byte
# base64 encryption key with crypto.randomBytes(32).toString("base64").
SCIENTISTFLOW_INSTALLATION_ID=
SCIENTISTFLOW_MODEL_MASTER_KEY=

# Optional Windows desktop file associations. Leave disabled on remote/cloud hosts.
# Enable only when serving the local desktop on loopback (see docs/file-workbench.md).
WORKSPACE_DESKTOP_OPEN=0

# Optional worker settings for shared HTTP tools. The default uses system DNS.
# Use Google's HTTPS resolver on networks that return synthetic addresses.
# SCIENTISTFLOW_TOOL_DNS=google
# Authorize an exact HTTPS origin per dedicated Bearer environment variable.
# SCIENTISTFLOW_TOOL_BEARER_ORIGINS={"TOOL_PAPER_API_TOKEN":"https://api.example.com"}
# Supply TOOL_PAPER_API_TOKEN to the worker through its secret configuration.
